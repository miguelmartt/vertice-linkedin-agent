# Configuración de vertice-linkedin-agent. En el VPS: /etc/vertice-linkedin-agent/env
# Se lee como datos (KEY=valor), igual que EnvironmentFile= de systemd: sin pasar por un shell.

# --- Obligatorio -------------------------------------------------------------

# Bot de Telegram propio, creado con @BotFather. No reutilices el de otro agente:
# Telegram solo deja a un proceso leer los mensajes de cada bot.
VLA_TELEGRAM_TOKEN=
# Tu id de usuario (en tu chat privado con el bot coincide con el del chat).
VLA_TELEGRAM_CHAT_ID=

# Claude Code con tu suscripción: sale de `claude setup-token` en tu ordenador.
CLAUDE_CODE_OAUTH_TOKEN=

# App de https://www.linkedin.com/developers con los productos «Share on LinkedIn» y
# «Sign In with LinkedIn using OpenID Connect». La URL de vuelta, registrada en la pestaña Auth
# exactamente igual, puede ser cualquier página https tuya: solo copias su dirección.
VLA_LINKEDIN_CLIENT_ID=
VLA_LINKEDIN_CLIENT_SECRET=
VLA_LINKEDIN_REDIRECT_URI=https://tu-dominio.es/linkedin/callback

# Quién escribe: entra en el prompt de Claude.
VLA_OWNER=Tu Nombre
VLA_ABOUT=Desarrollador freelance. IA aplicada y software a medida para empresas.

# --- Opcional ----------------------------------------------------------------

# Tus repos open source: usuarios u organizaciones de GitHub, separados por comas.
# VLA_GITHUB_OWNERS=tu-usuario,tu-organizacion
# VLA_OWN_EXCLUDE=repo-que-no-quieres-promocionar
# VLA_OWN_PER_WEEK=1
# Sube el límite de la API de GitHub (60 peticiones por hora sin token). Sin permisos.
# VLA_GITHUB_TOKEN=

# Cuándo (hora de VLA_TIMEZONE).
# VLA_DRAFT_SCHEDULE=mon,wed,fri 08:30
# VLA_COLLECT_SCHEDULE=every 3h
# VLA_DAILY_SCHEDULE=09:00
# VLA_TIMEZONE=Europe/Madrid

# Fuentes y umbrales.
# VLA_FEEDS=https://openai.com/news/rss.xml,https://deepmind.google/blog/rss.xml
# VLA_HN_MIN_POINTS=250
# VLA_GITHUB_MIN_STARS=150
# VLA_HF_MIN_LIKES=100

# Claude y LinkedIn.
# VLA_MODEL=opus
# VLA_LLM_MAX_CALLS_PER_DAY=15
# VLA_LINKEDIN_VERSION=202610

# Pruebas: Telegram funciona igual, pero no publica en LinkedIn.
# VLA_DRY_RUN=1
